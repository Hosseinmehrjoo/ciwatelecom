# CIWA Telecom environment template.
# Copy this file to .env and fill in local values. .env is gitignored.

CIWA_ENV=development
CIWA_API_PORT=8788
CIWA_HTTP_PORT=8080
# production: CIWA_ENV=production CIWA_SERVE_UI=1 CIWA_TRUST_PROXY=1
# CIWA_HEALTH_CHECK_AMI=1
# CIWA_LOGIN_MAX_ATTEMPTS=20
# CIWA_DATABASE_URL=postgres://ciwa:secret@127.0.0.1:5432/ciwa_telecom
CIWA_DB_NAME=ciwa_telecom
CIWA_DB_USER=ciwa
CIWA_DB_PASSWORD=changeme
# Set to 1 only for local debugging (disables API login)
# CIWA_DISABLE_AUTH=0
# Optional: restrict browser origin in production
# CIWA_CORS_ORIGIN=http://127.0.0.1:5173

# Paths are relative to the repository root.
# core/asterisk is an existing clone and must not be modified.
ASTERISK_SOURCE_DIR=core/asterisk
ASTERISK_CONFIG_DIR=config/asterisk
FREEPBX_CONFIG_DIR=config/freepbx
CIWA_CONFIG_DIR=config/ciwa

STORAGE_DIR=storage
LOG_DIR=logs
DATABASE_BACKUP_DIR=database/backups

# Asterisk Manager Interface (when Asterisk is running)
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=ciwa
AMI_SECRET=ciwa
AMI_TIMEOUT_MS=2500
