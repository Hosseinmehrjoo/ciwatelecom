FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tar ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/api/package.json backend/api/package-lock.json ./backend/api/
RUN cd backend/api && npm ci --omit=dev
COPY backend ./backend
COPY config ./config
ENV NODE_ENV=production
ENV CIWA_ENV=production
ENV CIWA_TRUST_PROXY=1
WORKDIR /app/backend/api
EXPOSE 8788
CMD ["node", "src/server.js"]
